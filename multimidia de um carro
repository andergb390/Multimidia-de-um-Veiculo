<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Multimídia Automotiva</title>
<style>
:root{--s1:#c8ecff;--s2:#72baf0;--card:#ffffffcc;--ink:#0b2e4f;--mute:#4f7394;--acc:#1796f0;--neon:#35f0e0;--bar:#2f93e6;--bz:#0e1012}
:root[data-theme="night"]{--s1:#16345f;--s2:#0a1730;--card:#17284acc;--ink:#e3f2ff;--mute:#8fb0d4;--acc:#35b4ff;--bar:#12306a}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Roboto,system-ui,sans-serif;background:#1b1d20;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px;color:var(--ink)}
button{all:unset;cursor:pointer;box-sizing:border-box}
button:focus-visible,[tabindex]:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid #ffd24a;outline-offset:2px}
.ic{width:22px;height:22px;fill:currentColor;flex:none}
.side{display:flex;flex-direction:column;align-items:center;gap:8px}
.pb{width:62px;height:40px;border-radius:9px;background:#23262a;border:1px solid #34383d;color:#e8eaed;font-size:11px;font-weight:600;display:grid;place-items:center;letter-spacing:.04em}
.pb:active{background:#3a3f45}
.pb.sm{height:24px;font-size:9px;width:46px}
.knob{width:58px;height:58px;border-radius:50%;margin-top:14px;background:conic-gradient(#555,#222,#666,#222,#555);border:3px solid #3b3f44;position:relative;touch-action:none}
.knob::after{content:"";position:absolute;left:50%;top:5px;width:4px;height:12px;margin-left:-2px;background:#e8eaed;border-radius:2px}
.kl{font-size:9px;color:#9aa0a6}
.bezel{width:100%;max-width:620px;background:var(--bz);border-radius:34px;padding:18px 12px;display:grid;grid-template-columns:72px 1fr 72px;gap:8px;align-items:center}
.screen{height:min(660px,calc(100vh - 40px));min-height:560px;border-radius:16px;overflow:hidden;position:relative;display:grid;grid-template-rows:30px 1fr 64px;background:linear-gradient(180deg,var(--s1),var(--s2))}
.sb{display:flex;justify-content:space-between;align-items:center;padding:0 10px;font-size:13px;font-weight:600;z-index:2}
.sb span,.sb button{display:flex;align-items:center;gap:6px}
.sb .ic{width:16px;height:16px}
#sbBt.off{opacity:.35}
main{position:relative;min-height:0}
.pg{position:absolute;inset:0;display:none;flex-direction:column;min-height:0}
.pg.on{display:flex}
.scene{flex:1.1;min-height:0}
.scene svg{width:100%;height:100%;display:block}
.wrow{display:flex;gap:7px;padding:0 8px;height:150px}
.wcol{display:flex;flex-direction:column;gap:5px;width:62px}
.wcol button,.wcard{background:var(--card);border-radius:12px;backdrop-filter:blur(6px)}
.wcol button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:9px;gap:2px}
.wcard{flex:1;padding:8px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;min-width:0}
.an{width:62px;height:62px}
.dig{font-size:26px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.dt{font-size:10px;color:var(--mute);text-align:center}
.art{width:50px;height:50px;border-radius:10px;background:linear-gradient(135deg,#102a5c,#1796f0);display:grid;place-items:center}
.eq{display:flex;gap:3px;align-items:flex-end;height:22px}
.eq i{width:4px;height:8px;background:#fff;border-radius:2px}
.on-air .eq i{animation:eq .9s ease-in-out infinite alternate}
.eq i:nth-child(2){animation-delay:.2s!important}.eq i:nth-child(3){animation-delay:.4s!important}.eq i:nth-child(4){animation-delay:.1s!important}
@keyframes eq{to{height:22px}}
.rt{font-size:13px;font-weight:700;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.rs{font-size:10px;color:var(--mute)}
.rc{display:flex;gap:10px;align-items:center}
.rc button,.rbtn{width:30px;height:30px;display:grid;place-items:center;border-radius:50%}
.rc .pp,.pp{background:var(--acc);color:#fff;width:34px;height:34px;box-shadow:0 0 0 4px #1796f033}
.dock{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;padding:8px 6px 6px;align-items:end;height:84px}
.dock button,.apps button{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;color:var(--ink)}
.dock .bub,.apps .bub{width:36px;height:36px;border-radius:50%;background:var(--card);display:grid;place-items:center;color:var(--acc)}
.dock .mid .bub{width:48px;height:48px;background:var(--acc);color:#fff;box-shadow:0 0 14px #1796f099}
.bar{background:var(--bar);display:grid;grid-template-columns:54px 1fr 54px;align-items:center;color:#fff;z-index:2}
.bar .col{display:flex;flex-direction:column;align-items:center;justify-content:space-around;height:100%;padding:4px 0}
.bar .col button{width:44px;height:26px;display:grid;place-items:center;border-radius:8px;position:relative}
.bar .col button:active{background:#ffffff33}
.bar .col button.vb{display:flex;gap:2px;font-weight:700;font-size:14px;align-items:center;justify-content:center}
.bar .vb .ic{width:18px;height:18px}
#btText{text-align:center;font-size:15px;font-weight:500}
.hd{display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:18px;font-weight:700}
.hd button{width:36px;height:36px;border-radius:50%;background:var(--card);display:grid;place-items:center}
.body{flex:1;overflow:auto;padding:6px 14px 14px;display:flex;flex-direction:column;gap:12px;min-height:0}
.panel{background:var(--card);border-radius:14px;padding:14px}
.btn{background:var(--acc);color:#fff;border-radius:10px;padding:11px 14px;text-align:center;font-weight:600;font-size:14px;display:block;text-decoration:none}
.btn.alt{background:var(--card);color:var(--ink)}
.row{display:flex;gap:8px;align-items:center;justify-content:center}
.big{font-size:44px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums}
.sub{text-align:center;color:var(--mute);font-size:13px}
input[type=range]{width:100%;accent-color:var(--acc)}
.pre{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.pre button,.list button,.seg button{background:#ffffff88;border-radius:10px;padding:10px;text-align:center;font-weight:600;font-size:14px}
.pre button[aria-pressed="true"],.list button[aria-pressed="true"],.seg button[aria-pressed="true"]{background:var(--acc);color:#fff}
.list{display:flex;flex-direction:column;gap:6px}
.list button{text-align:left;display:flex;justify-content:space-between}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pad button{background:var(--card);border-radius:12px;height:46px;display:grid;place-items:center;font-size:22px;font-weight:600}
.pad button:active{background:var(--acc);color:#fff}
.cover{width:140px;height:140px;border-radius:16px;margin:0 auto;background:linear-gradient(135deg,#e91e63,#1796f0);display:grid;place-items:center;color:#fff}
.cover .ic{width:56px;height:56px}
.prog{height:5px;background:#ffffff88;border-radius:3px;overflow:hidden}
.prog i{display:block;height:100%;background:var(--acc);width:0}
.apps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 4px}
.apps .bub{width:52px;height:52px}
iframe{width:100%;flex:1;min-height:240px;border:0;border-radius:12px;background:#dde}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.sw{display:flex;justify-content:space-between;align-items:center;font-weight:600}
.sw button{width:48px;height:26px;border-radius:13px;background:#9ab;position:relative}
.sw button[aria-pressed="true"]{background:var(--acc)}
.sw button::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .15s}
.sw button[aria-pressed="true"]::after{left:25px}
.toast{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);background:#0b1a2ef0;color:#fff;border-radius:12px;padding:12px 20px;font-size:17px;font-weight:600;z-index:6;max-width:86%;text-align:center}
.toast[hidden]{display:none}
.off{position:absolute;inset:0;background:#000;z-index:9;display:none;align-items:center;justify-content:center;color:#456;font-size:13px}
.off.on{display:flex}
@media (max-width:520px){.bezel{grid-template-columns:54px 1fr 54px;padding:12px 6px;border-radius:24px}.pb{width:48px;font-size:9px}.knob{width:46px;height:46px}.pb.sm{width:38px}}
#sbSn{display:none;color:#ff5a5f;font-size:11px}
#sbSn.on{display:flex}
.cams{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cam{height:84px;border-radius:12px;background:linear-gradient(160deg,#0f1f33,#16314f);position:relative;overflow:hidden;color:#cfe8ff;font-size:12px;font-weight:600}
.cam span{position:absolute;left:8px;bottom:6px}
.cam em{position:absolute;right:8px;top:6px;font-style:normal;font-size:10px;color:#ff6b6b;display:none}
.armed .cam em{display:block}
.cam::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:#35f0e066;display:none}
.armed .cam::after{display:block}
.cam.alert{outline:3px solid #ff4d4d;outline-offset:-3px}
.alertbar{background:#e5484d;color:#fff;border-radius:12px;padding:12px;font-weight:700;text-align:center;font-size:14px}
@media (prefers-reduced-motion:no-preference){.armed .cam::after{animation:scan 2.500s linear infinite}@keyframes scan{to{top:100%}}}
@media (prefers-reduced-motion:reduce){.on-air .eq i,.lane{animation:none!important}}
@media (prefers-reduced-motion:no-preference){.lane{animation:lane 1s linear infinite}@keyframes lane{to{stroke-dashoffset:-24}}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="i-home" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></symbol>
<symbol id="i-back" viewBox="0 0 24 24"><path d="M20 11H7.800l5.600-5.600L12 4l-8 8 8 8 1.400-1.400L7.800 13H20z"/></symbol>
